---
import { formatPublished, type NewsItem } from '../lib/content';

interface Props {
  items: NewsItem[];
}
const { items } = Astro.props;
---

{items.length === 0 ? (
  <p class="empty">No headlines are available right now. Please check back soon.</p>
) : (
  <ul class="news-list">
    {items.map((item) => (
      <li>
        <p class="meta">
          <span class="tag">{item.source}</span>{formatPublished(item.published)}
        </p>
        <a class="headline" href={item.link} rel="noopener noreferrer" target="_blank">{item.title}<span class="sr-only"> (opens the original story in a new tab)</span></a>
        {item.snippet && <p>{item.snippet}</p>}
      </li>
    ))}
  </ul>
)}

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>

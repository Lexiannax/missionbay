---
import Base from '../layouts/Base.astro';
import { getNewsletters, formatMonth } from '../lib/content';
import links from '../data/resident-links.json';

const issues = await getNewsletters();
const recent = issues.filter((i) => i.data.access === 'residents');
const open = issues.filter((i) => i.data.access !== 'residents' && i.data.pdf);
const years = [...new Set(open.map((i) => i.data.issueDate.getUTCFullYear()))].sort((a, b) => b - a);
---

<Base title="Newsletter" description="The Mission Bay News monthly newsletter, kept in a private library for Mission Bay residents.">
  <h1>Newsletter Archive</h1>
  <p class="lede">Every monthly issue of Mission Bay News is kept in a private library for Mission Bay residents.</p>

  {recent.length > 0 && (
    <div class="framed">
      <h2 style="margin-top:0">Residents only</h2>
      <p>
        {recent.length} issues ({formatMonth(recent[recent.length - 1].data.issueDate)} to {formatMonth(recent[0].data.issueDate)})
        are in the private residents' library.
      </p>
      <p>
        {links.libraryUrl && <a class="button dark" href={links.libraryUrl} rel="noopener">Open the residents' library</a>}
        <a class={links.libraryUrl ? 'button secondary' : 'button dark'} href="/residents/">How residents get access</a>
      </p>
    </div>
  )}

  {years.map((year) => (
    <section>
      <h2>{year}</h2>
      <div class="grid">
        {open.filter((i) => i.data.issueDate.getUTCFullYear() === year).map((i) => (
          <div class="card">
            <h3>{formatMonth(i.data.issueDate)}</h3>
            <p><a href={i.data.pdf}>Read the PDF</a></p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="callout">
    <p><strong>Send us your news for the next issue.</strong></p>
    <p>Birthdays, anniversaries, club news, letters and corrections. Deadline: the 10th of the month before publication.</p>
    <p><a href="mailto:missionbaynews@gmail.com">missionbaynews@gmail.com</a></p>
  </div>
</Base>

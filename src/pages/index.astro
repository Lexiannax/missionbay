---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsList from '../components/NewsList.astro';
import Sponsor from '../components/Sponsor.astro';
import { getArticles, getNewsletters, loadNews, formatMonth } from '../lib/content';

const articles = await getArticles();
const sorted = [...articles].sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned));
const latest = sorted.slice(0, 3);
const [latestIssue] = await getNewsletters();
const headlines = loadNews().items.slice(0, 6);
---

<Base title="Home">
  <section class="hero">
    <h1>Welcome to Mission Bay Community News</h1>
    <p>
      The resident-run newsletter and information hub for the Mission Bay community in San Leandro. Not affiliated with park
      management.
    </p>
    {latestIssue && <a class="button" href="/newsletter/">Read the {formatMonth(latestIssue.data.issueDate)} issue</a>}
    <a class="button secondary" href="/rights/">Know your rent rights</a>
  </section>

  <section>
    <h2>Latest from Mission Bay</h2>
    {latest.length === 0 ? (
      <p class="empty">No articles yet. Check back soon.</p>
    ) : (
      <div class="grid">
        {latest.map((a) => <ArticleCard article={a} />)}
      </div>
    )}
    <a class="more-link" href="/articles/">All Mission Bay news →</a>
  </section>

  <section>
    <h2>Local news headlines</h2>
    <NewsList items={headlines} />
    <a class="more-link" href="/news/">More local news →</a>
  </section>

  <div class="callout">
    <p><strong>Your rights: San Leandro's Rent Stabilization Ordinance.</strong></p>
    <p>The 2026 rent increase cap is 2.2%, and management must give you 90 days' written notice. <a href="/rights/">Read what that means for you.</a></p>
    <p>Dispute a charge: <span class="phone">510-577-6006</span> · Free tenant counseling: <span class="phone">510-581-9380</span></p>
  </div>

  <Sponsor />
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="Resident Registration" description="Register to read the Mission Bay newsletter archive." searchable={false}>
  <h1>Register to read the newsletter</h1>
  <p class="lede">The newsletter archive is for Mission Bay residents. It takes about 30 seconds.</p>

  <form id="register" class="framed form" novalidate>
    <p>
      <label for="reg-name">Your first and last name</label>
      <input id="reg-name" name="name" type="text" autocomplete="name" required />
    </p>
    <p>
      <label for="reg-lot">Your lot number (1 to 400)</label>
      <input id="reg-lot" name="lot" type="text" inputmode="numeric" autocomplete="off" required />
      <span class="hint">You can find it on your lease. If you're not sure, ask the park office.</span>
    </p>
    <p id="reg-error" class="error" role="alert" hidden></p>
    <p><button class="button dark" type="submit">Continue to the newsletter</button></p>
    <p class="hint">
      Your name and lot number stay on this device only. We do not collect or store them. You'll stay registered on this
      device until you choose to sign out.
    </p>
  </form>

  <p>Prefer to ask for a copy by email? Write to <a href="mailto:missionbaynews@gmail.com">missionbaynews@gmail.com</a>.</p>

  <script is:inline>
    (function () {
      var form = document.getElementById('register');
      var err = document.getElementById('reg-error');
      function fail(msg, field) {
        err.textContent = msg;
        err.hidden = false;
        if (field) field.focus();
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        err.hidden = true;
        var name = document.getElementById('reg-name');
        var lot = document.getElementById('reg-lot');
        var n = name.value.trim();
        var l = parseInt(lot.value.trim(), 10);
        if (n.length < 2) return fail('Please enter your name.', name);
        if (!l || l < 1 || l > 400 || String(l) !== lot.value.trim()) return fail('Please enter your lot number, a number from 1 to 400.', lot);
        try {
          localStorage.setItem('mb-resident', '1');
          localStorage.setItem('mb-resident-name', n.split(/\s+/)[0]);
        } catch (x) {
          return fail('Your browser is blocking the site from remembering you. Please turn off private browsing, or email us for a copy.');
        }
        window.location.href = '/newsletter/';
      });
    })();
  </script>
</Base>

<style is:global>
  .form label { display: block; font-family: var(--label); font-weight: 600; letter-spacing: 0.06em; margin-bottom: 0.35rem; }
  .form input[type='text'] {
    width: 100%; max-width: 26rem; font: inherit; font-size: 1.1rem; padding: 0.8rem 0.9rem; min-height: 3rem;
    border: 2px solid var(--navy); background: #fff; color: var(--ink);
  }
  .form .hint { display: block; font-size: 0.9rem; color: var(--muted); margin-top: 0.35rem; }
  .form .error { background: #fbe7e4; border-left: 6px solid var(--no); padding: 0.75rem 1rem; color: #5c1a1a; font-weight: 700; }
  .form button.button { cursor: pointer; font-family: var(--label); }
</style>

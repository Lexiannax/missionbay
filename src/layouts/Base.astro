---
import '../styles/global.css';
import ads from '../data/ads.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Pages that should not appear in site search (search results, the aggregator). */
  searchable?: boolean;
}

const { title, description = 'Reliable local news for the residents of Mission Bay, San Leandro, California.', image, searchable = true } = Astro.props;
const pageTitle = title === 'Home' ? 'Mission Bay Community News — San Leandro, CA' : `${title} — Mission Bay News`;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/articles/', label: 'Mission Bay News' },
  { href: '/news/', label: 'Local News' },
  { href: '/events/', label: 'Events' },
  { href: '/newsletter/', label: 'Newsletter' },
  { href: '/residents/', label: 'Residents' },
  { href: '/resources/', label: 'Resources' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const canonical = new URL(path, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="alternate" type="application/rss+xml" title="Mission Bay News" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Josefin+Sans:wght@400;600&family=Lora:ital,wght@0,400;0,700;1,400&display=swap"
    />
    {ads.publisherId && (
      <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.publisherId}`} crossorigin="anonymous"></script>
    )}
    <script is:inline>
      try {
        var s = localStorage.getItem('mb-text-size');
        if (s) document.documentElement.dataset.size = s;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="utility">
        <div class="utility-inner">
          <div class="utility-links">
            <a href="/search/">Search</a>
            <a href="/about/">About</a>
            <a href="/photos/">Photos</a>
          </div>
          <div class="lang notranslate" role="group" aria-label="Language">
            <button type="button" data-lang="" aria-pressed="true" lang="en">English</button>
            <button type="button" data-lang="zh-TW" aria-pressed="false" lang="zh-Hant">繁體中文</button>
            <button type="button" data-lang="zh-CN" aria-pressed="false" lang="zh-Hans">简体中文</button>
          </div>
          <div class="text-size" role="group" aria-label="Text size">
            <span>Text size</span>
            <button type="button" translate="no" data-size="" aria-label="Normal text size" aria-pressed="true">A</button>
            <button type="button" translate="no" data-size="large" aria-label="Large text size" aria-pressed="false" style="font-size:1.15em">A</button>
            <button type="button" translate="no" data-size="xlarge" aria-label="Extra large text size" aria-pressed="false" style="font-size:1.35em">A</button>
          </div>
        </div>
      </div>

      <div class="masthead">
        <a href="/">
          <span class="est">★ Established 1971 ★</span>
          <span class="name" translate="no">MISSION BAY</span>
          <span class="sub">Community News · San Leandro</span>
        </a>
      </div>

      <nav class="main-nav" aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <p class="lang-note" id="lang-note" hidden>Automatic translation by Google. It may contain mistakes. In an emergency, call 911.</p>
    <div id="google_translate_element" class="gt-hidden notranslate" aria-hidden="true"></div>

    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-name">Mission Bay Community News</p>
      <p>15333 Wicks Blvd, San Leandro CA 94579</p>
      <p>Editor: Alexandra McKeever · <a href="/contact/">Contact the editor</a></p>
      <p>Not affiliated with park management. Content is for general information only.</p>
      <p>
        <a href="/search/">Search</a> &middot; <a href="/about/">About</a> &middot; <a href="/privacy/">Privacy</a> &middot; <a href="/rss.xml">RSS feed</a> &middot; <a href="/photos/">Photos</a> &middot; <a href="/flood-map/">Flood map</a> &middot; <a href="/civic-watch/">Civic Watch</a> &middot; <a href="/crime-corridor-map/">Crime Corridor</a> &middot; <a href="/admin/">Editor sign-in</a>
      </p>
    </footer>

    <script is:inline>
      (function () {
        var buttons = document.querySelectorAll('.text-size button');
        function mark(size) {
          buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.size === size)); });
        }
        mark(document.documentElement.dataset.size || '');
        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            var size = b.dataset.size;
            if (size) document.documentElement.dataset.size = size;
            else delete document.documentElement.dataset.size;
            try { localStorage.setItem('mb-text-size', size); } catch (e) {}
            mark(size);
          });
        });
      })();
    </script>
    <script is:inline>
      // Chinese translation. Google's translator is loaded only after a visitor picks a Chinese button.
      (function () {
        var m = /(?:^|;\s*)googtrans=\/en\/(zh-(?:TW|CN))/.exec(document.cookie);
        var current = m ? m[1] : '';
        var buttons = document.querySelectorAll('.lang button');
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.lang === current)); });

        function clearCookie() {
          var host = location.hostname, past = 'googtrans=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
          document.cookie = past;
          document.cookie = past + ';domain=' + host;
          document.cookie = past + ';domain=.' + host;
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            var lang = b.dataset.lang;
            clearCookie();
            if (lang) document.cookie = 'googtrans=/en/' + lang + ';path=/';
            location.reload();
          });
        });

        if (current) {
          document.getElementById('lang-note').hidden = false;
          window.googleTranslateElementInit = function () {
            new google.translate.TranslateElement(
              { pageLanguage: 'en', includedLanguages: 'zh-TW,zh-CN', autoDisplay: false },
              'google_translate_element'
            );
          };
          var s = document.createElement('script');
          s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
          s.async = true;
          document.head.appendChild(s);
        }
      })();
    </script>
  </body>
</html>
